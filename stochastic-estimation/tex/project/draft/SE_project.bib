	note = {Publisher: Nature Publishing Group},
	keywords = {Batteries, Electrical and electronic engineering, Scientific data},
	pages = {1020},
	file = {Full Text PDF:/home/sean/Zotero/storage/JKFTRYH4/Stroebl et al. - 2024 - A multi-stage lithium-ion battery aging dataset us.pdf:application/pdf},
}

