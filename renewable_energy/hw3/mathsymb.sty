\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathsymb}[2023/09/12 mathsymb]

\RequirePackage{amsmath, amssymb}

\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\X}{\mathcal{X}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\norm}[1]{\lVert #1 \rVert_2}
\newcommand{\normp}[2]{\lVert #1 \rVert_{#2}}
\newcommand{\normi}[1]{\lVert #1 \rVert_\infty}
\newcommand{\mnorm}[1]{\biggl\lVert \mat{ #1 } \biggr\rVert_2}

% Systems and Controls symbols
\newcommand{\xc}{{\bf x}}
\newcommand{\uc}{{\bf u}}

\newcommand{\eval}{\biggr\rvert}
\newcommand{\mat}[1]{\begin{bmatrix} #1 \end{bmatrix}}

\newcommand{\V}{\text{ V}}
\newcommand{\Vb}{\text{[V]}}
\newcommand{\psd}{\succeq 0}