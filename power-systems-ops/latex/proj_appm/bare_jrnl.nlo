\nomenclatureentry{A$\X$@[{$\X$}]\begingroup Set of externals\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\B$@[{$\B$}]\begingroup Set of all BESS externals\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\L$@[{$\L$}]\begingroup Set of Transmission Lines\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\N$@[{$\N$}]\begingroup Set of buses in network\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\T$@[{$\T$}]\begingroup Set of timesteps\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\C_P$@[{$\C_P$}]\begingroup Subset of externals with configurable power capacities\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\C_E$@[{$\C_E$}]\begingroup Subset of externals with configurable energy capacities\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\gamma_{x, t}$@[{$\gamma_{x, t}$}]\begingroup Capacity factor of external $x\in\X$ at time $t\in\T$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{A$\mathcal{F}$@[{$\mathcal{F}$}]\begingroup Power Distribution Transfer Matrix\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$T_x$@[{$T_x$}]\begingroup Expected lifetime of external $x$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$C_{0,P,x}$@[{$C_{0,P,x}$}]\begingroup Capital Cost per unit of installed power capacity (\$/MW) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$C_{1,P,x}$@[{$C_{1,P,x}$}]\begingroup Variable cost per unit of power generation (\$/MW) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$C_{0,E,x}$@[{$C_{0,E,x}$}]\begingroup Capital Cost per unit of installed energy capacity (\$/MWh) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$C_{1,E,x}$@[{$C_{1,E,x}$}]\begingroup Variable cost per unit of energy stored (\$/MWh) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{B$f$@[{$f$}]\begingroup Total (annualized) system cost\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$D$@[{$D$}]\begingroup Differential Operator\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\Phi_1 \in \R^{\sizeX \times \sizeC}$@[{$\Phi_1 \in \R^{\sizeX \times \sizeC}$}]\begingroup Capacity Map: power lower bound\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\Phi_2 \in \R^{\sizeX \times \sizeC}$@[{$\Phi_2 \in \R^{\sizeX \times \sizeC}$}]\begingroup Capacity Map: power upper bound\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\Phi_3 \in \R^{\sizeX \times \sizeC}$@[{$\Phi_3 \in \R^{\sizeX \times \sizeC}$}]\begingroup Capacity Map: energy lower bound\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\Psi \in \R^{\|\N\|\times\|\X\|}$@[{$\Psi \in \R^{\|\N\|\times\|\X\|}$}]\begingroup Bus Injection Map\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$p_{x,t}$@[{$p_{x,t}$}]\begingroup (Real) power (MW) injected by external $x \in \X$ at time $t\in\T$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$p_{n,t}$@[{$p_{n,t}$}]\begingroup Total (real) power (MW) injected at node $n \in \N$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$p_{\ell,t}$@[{$p_{\ell,t}$}]\begingroup Power flow (MW) on line $\ell \in \L$ at time $t\in\T$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\bar{P}_x$@[{$\bar{P}_x$}]\begingroup Power capacity (MW) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\bar{E}_x$@[{$\bar{E}_x$}]\begingroup Energy capacity (MWh) for external $x\in\X$\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\eta_c \in [0, 1]$@[{$\eta_c \in [0, 1]$}]\begingroup BESS charge efficiency\nomeqref {0}|nompageref}{1}
\nomenclatureentry{a$\eta_d \in [0, 1]$@[{$\eta_d \in [0, 1]$}]\begingroup BESS discharge efficiency\nomeqref {0}|nompageref}{1}
